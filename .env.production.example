# =============================================================================
# HR LINE Bot — PRODUCTION environment (example, no real secrets)
#
# Production guards enforced by `npm run validate:env -- --prod` and /api/ready:
#   - APP_BASE_URL and GOOGLE_APPS_SCRIPT_URL must be HTTPS (no localhost)
#   - INTERNAL_API_SECRET is required
#   - No placeholder values (YOUR_..., changeme, example)
#   - EMPLOYEE and MANAGER access tokens must differ
#   - Use the PRODUCTION Google Sheet + Apps Script (never staging)
# =============================================================================

NODE_ENV=production

# ---- Employee bot (PRODUCTION channel) ----
EMPLOYEE_LINE_CHANNEL_ACCESS_TOKEN=
EMPLOYEE_LINE_CHANNEL_SECRET=
EMPLOYEE_LIFF_ID=
EMPLOYEE_LINE_LOGIN_CHANNEL_ID=

# ---- Manager bot (PRODUCTION channel — separate from employee) ----
MANAGER_LINE_CHANNEL_ACCESS_TOKEN=
MANAGER_LINE_CHANNEL_SECRET=
MANAGER_GROUP_ID=
MANAGER_USER_IDS=
HR_ADMIN_USER_IDS=

# ---- App (PRODUCTION domain — HTTPS required) ----
APP_BASE_URL=https://hr.your-domain.com
INTERNAL_API_SECRET=

# ---- Leave rules ----
LEAVE_COUNT_WEEKENDS=false

# ---- Google (PRODUCTION spreadsheet + Apps Script deployment) ----
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_APPS_SCRIPT_URL=

# ---- Public LIFF IDs (PRODUCTION) ----
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_LIFF_ID_BALANCE=
NEXT_PUBLIC_LIFF_ID_CHECKIN=
NEXT_PUBLIC_LIFF_ID_CHECKOUT=
