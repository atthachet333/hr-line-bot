# =============================================================================
# HR LINE Bot — STAGING environment (example, no real secrets)
# Use a SEPARATE LINE channels, LIFF apps, Google Sheet and Apps Script from
# production so testing never touches production data.
# =============================================================================

NODE_ENV=production

# ---- Employee bot (STAGING channel) ----
EMPLOYEE_LINE_CHANNEL_ACCESS_TOKEN=
EMPLOYEE_LINE_CHANNEL_SECRET=
EMPLOYEE_LIFF_ID=
EMPLOYEE_LINE_LOGIN_CHANNEL_ID=

# ---- Manager bot (STAGING channel — separate from employee) ----
MANAGER_LINE_CHANNEL_ACCESS_TOKEN=
MANAGER_LINE_CHANNEL_SECRET=
MANAGER_GROUP_ID=
MANAGER_USER_IDS=
HR_ADMIN_USER_IDS=

# ---- App (STAGING domain — HTTPS, never localhost) ----
APP_BASE_URL=https://staging.your-domain.com
INTERNAL_API_SECRET=

# ---- Leave rules ----
LEAVE_COUNT_WEEKENDS=false

# ---- Google (STAGING spreadsheet + Apps Script deployment) ----
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_APPS_SCRIPT_URL=

# ---- Public LIFF IDs (STAGING) ----
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_LIFF_ID_BALANCE=
NEXT_PUBLIC_LIFF_ID_CHECKIN=
NEXT_PUBLIC_LIFF_ID_CHECKOUT=
