# =============================================================================
# HR LINE Bot — Environment Variables (example)
# Copy to .env.local and fill in real values. DO NOT commit .env.local.
# No real tokens / secrets belong in this file.
# =============================================================================

# ---- Employee bot (Messaging API channel + LIFF / LINE Login) ----
# Channel access token of the Employee Messaging API channel (used to push
# approval / rejection results to employees).
EMPLOYEE_LINE_CHANNEL_ACCESS_TOKEN=
# Channel secret of the Employee channel (reserved; not required for push).
EMPLOYEE_LINE_CHANNEL_SECRET=
# The LIFF ID of the Employee LIFF app (server side reference / docs).
EMPLOYEE_LIFF_ID=
# The LINE Login channel ID that the Employee LIFF app belongs to. Used as the
# expected audience when verifying LIFF ID tokens. If omitted, the numeric prefix
# of EMPLOYEE_LIFF_ID is used as a fallback.
EMPLOYEE_LINE_LOGIN_CHANNEL_ID=

# ---- Manager bot (SEPARATE Messaging API channel) ----
# Channel access token of the Manager Messaging API channel (sends the leave
# request Flex Message and replies to approve/reject postbacks).
MANAGER_LINE_CHANNEL_ACCESS_TOKEN=
# Channel secret of the Manager channel. REQUIRED — used to verify the
# x-line-signature of the manager webhook.
MANAGER_LINE_CHANNEL_SECRET=
# Group ID that receives manager notifications (optional). If set, the Flex
# Message is pushed to this group instead of individual managers.
MANAGER_GROUP_ID=
# Comma-separated list of manager LINE user IDs allowed to approve/reject.
# Authorisation is checked against event.source.userId on the webhook.
# Example: Uaaaa1111...,Ubbbb2222...
MANAGER_USER_IDS=
# Comma-separated LINE user IDs with HR-admin rights (can approve/reject ANY
# request, including ones with no assigned manager).
HR_ADMIN_USER_IDS=

# ---- App ----
# Public base URL of this app, e.g. https://your-domain.com (used in docs/links).
APP_BASE_URL=
# Shared secret protecting internal admin endpoints (notification retry).
# REQUIRED in production. Send as: Authorization: Bearer <secret>
INTERNAL_API_SECRET=

# ---- Leave rules ----
# Count Saturday/Sunday as leave days (true/false). Default false.
LEAVE_COUNT_WEEKENDS=false

# ---- Status transition safety ----
# When false (recommended for production), approvals require the atomic Apps
# Script LockService path; the non-atomic read-check-write fallback is refused.
ALLOW_NON_ATOMIC_TRANSITION=false

# ---- Google (Sheets service account) ----
# Service account credentials used to read/write the Google Sheet directly.
GOOGLE_CLIENT_EMAIL=
# Private key — keep the literal \n escapes; they are converted at runtime.
GOOGLE_PRIVATE_KEY=
# Spreadsheet ID (the long id in the Google Sheets URL).
GOOGLE_SHEET_ID=

# ---- Google Apps Script (attendance + balance) ----
# Web app URL of the Apps Script deployment. SERVER-ONLY — never exposed to the
# browser. Handles checkin/checkout and getBalance actions.
GOOGLE_APPS_SCRIPT_URL=

# ---- Optional: override sheet/tab names (defaults shown) ----
# SHEET_LEAVE_REQUESTS=LeaveRequests
# SHEET_EMPLOYEES=Employees
# SHEET_AUDIT_LOG=AuditLog
# SHEET_HOLIDAYS=Holidays

# ---- Client (public) LIFF IDs — exposed to the browser via NEXT_PUBLIC_ ----
# All four LIFF apps MUST belong to the SAME Employee LINE Login channel that the
# backend verifies tokens against (EMPLOYEE_LINE_LOGIN_CHANNEL_ID). The Rich Menu
# should link to https://liff.line.me/<id> for each.
NEXT_PUBLIC_LIFF_ID=            # leave form (fallback for NEXT_PUBLIC_LIFF_ID_LEAVE)
NEXT_PUBLIC_LIFF_ID_LEAVE=     # optional explicit leave LIFF id (else uses NEXT_PUBLIC_LIFF_ID)
NEXT_PUBLIC_LIFF_ID_BALANCE=
NEXT_PUBLIC_LIFF_ID_CHECKIN=
NEXT_PUBLIC_LIFF_ID_CHECKOUT=

# Optional Manager/HR evidence-viewer LIFF app id (opens evidence in-app). Falls
# back to NEXT_PUBLIC_LIFF_ID when unset.
NEXT_PUBLIC_LIFF_ID_EVIDENCE=

# ---- Rich Menu update script (npm run richmenu:update) ----
# Path to the rich menu image (2500x1686 or 2500x843, PNG/JPEG).
RICH_MENU_IMAGE_PATH=config/richmenu.png

# ---- Leave evidence (optional attachment) ----
# Storage root OUTSIDE the repo (Windows path example). Files are stored as
# <root>/<employeeId>/<requestId>/<file>. Never commit this directory.
LEAVE_EVIDENCE_DIR=C:\S2A_DATA\hr-line-bot\leave-evidence
LEAVE_EVIDENCE_MAX_BYTES=10485760
LEAVE_EVIDENCE_RETENTION_DAYS=365
